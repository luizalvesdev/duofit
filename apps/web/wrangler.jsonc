{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static hosting for the PWA (Workers static assets). Build first: `npm run deploy`.
  "name": "duofit",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
